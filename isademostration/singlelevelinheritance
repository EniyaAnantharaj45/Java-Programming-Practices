package com.org.isademoStration;


class Rita{
	String name;
	int age;
	Rita(String name,int age){
		this.name=name;
		this.age=age;
	}
	public void singing() {
		System.out.println("sing Classical");
	}
}
class James extends Rita{
	String gender;
	
	James(String gender,String name,int age){
		super(name,age);
		this.gender=gender;
		this.age=age;
		
		
	}
	public void display() {
		System.out.println("Name:"+name);
		System.out.println("gender:"+gender);
		System.out.println("Age:"+age);
			
	}
				
}
public class SinglelevelInheritance {
	public static void main(String[]args) {
		James j1=new James("male","James",22);
		j1.display();
		j1.singing();
	}

}
